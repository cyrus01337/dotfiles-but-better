{
    "Service": {
        "prefix": "s",
        "body": [
            "local ${1:service} = game:GetService(\"$1\")"
        ]
    },
    "For loop through table": {
        "prefix": "fort",
        "body": [
            "for ${1:key}, ${2:value} in ${3:container} do",
            "\t$4",
            "end"
        ]
    },
    "Type": {
        "prefix": "t",
        "body": [
            "type ${1:name} = ${2:{}}"
        ]
    },
    "Typed variable": {
        "prefix": "lt",
        "body": [
            "local ${1:variable}: ${2:Type} = ${3:nil}"
        ]
    },
    "Typed function": {
        "prefix": "ft",
        "body": [
            "local function ${1:name}(${2:...}): ${3:Returns}",
            "\t$4",
            "end"
        ]
    },
    "Typed module function": {
        "prefix": "fmt",
        "body": [
            "function ${1:module}.${2:name}(${3:...}): ${4:Returns}",
            "\t$5",
            "end"
        ]
    },
    "Typed debounce table": {
        "prefix": "dtt",
        "body": [
            "local ${1:debounce}: { [${2:any}]: ${3:any} } = {}",
            "local ${4:debounceHit} = $1[$5]\n",
            "if $4 then",
            "\treturn",
            "end\n",
            "$1[$5] = ${6:true}\n",
            "$8\n",
            "$1[$5] = ${7:nil}"
        ]
    },
    "Typed weak table": {
        "prefix": "twt",
        "body": [
            "local ${1:variable} = setmetatable(${2:{}} ${3::: ${4:{ [${5:any}]: ${6:any} }}}, { __mode = \"k\" })"
        ]
    }
}
