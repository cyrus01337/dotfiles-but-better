spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "gammastep -l 54:2"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-sh-at-startup "flatpak run com.github.zocker_160.SyncThingy"
spawn-sh-at-startup "ydotoold --socket-path /tmp/.ydotool_socket --socket-perm 707"
spawn-at-startup "kded6"
spawn-at-startup "keepassxc --minimized"
spawn-at-startup "oniri --edges-maximizing --reclaim-space --tiling-layout"

spawn-at-startup "librewolf"
spawn-at-startup "alacritty"
