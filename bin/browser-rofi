#!/usr/bin/env bash
pkill rofi

browser=$(printf '%s\n' "LibreWolf" "Google Chrome" "Chromium" | rofi -dmenu -p "Browser")

case "$browser" in
    "LibreWolf")
        flatpak run io.gitlab.librewolf-community

        ;;
    "Google Chrome")
        flatpak run com.google.Chrome

        ;;
    "Chromium")
        chromium

        ;;
esac
